// Example: user-defined functions
// Water at 60 degC flowing in a 25 mm tube: properties, friction factor, Nusselt number,
// heat-transfer coefficient and pressure drop. A second part integrates cp with Simpson's rule.

// Properties: four outputs; T and P arrive in degC and kPa, outputs are SI and checked by Check Units
function [rho [kg/m^3], mu [Pa s], k [W/(m K)], Pr [-]] = water(T [degC], P [kPa])
  TK = T + 273.15
  PPa = P*1000
  rho = density('water', TK, PPa)
  mu = viscosity('water', TK, PPa)
  k = conductivity('water', TK, PPa)
  Pr = prandtl('water', TK, PPa)
end

// Darcy friction factor: laminar 64/Re, else the Colebrook equation iterated with a while loop
function f [-] = colebrook(Re, rr)
  if Re < 2300
    f = 64/Re
    return
  end
  f = 0.02
  n = 0
  while true
    f_new = (-2*log10(rr/3.7 + 2.51/(Re*sqrt(f))))^(-2)
    n = n + 1
    if abs(f_new - f) < 1e-12 or n > 50
      break
    end
    f = f_new
  end
  f = f_new
end

// Nusselt number: fully developed laminar (constant wall temperature), else Gnielinski
function Nu [-] = nusselt(Re, Pr, f)
  if Re < 2300
    Nu = 3.66
  elseif Re <= 5e6
    Nu = (f/8)*(Re - 1000)*Pr/(1 + 12.7*sqrt(f/8)*(Pr^(2/3) - 1))
  else
    error('Re is above the range of the Gnielinski correlation')
  end
end

T = 60 [degC]
P = 200 [kPa]
D = 0.025 [m]
rough = 0.000045 [m]
L = 10 [m]
V = 1.5 [m/s]
[rho, mu, k, Pr] = water(T, P)
Re = rho*V*D/mu
f = colebrook(Re, rough/D)
Nu = nusselt(Re, Pr, f)
h = Nu*k/D [W/(m^2 K)]
DeltaP = f*(L/D)*rho*V^2/2 [kPa]
// Backward solve: comment out  V = 1.5 [m/s]  and uncomment the next line to find V for a given h.
// The solver then works through colebrook() and nusselt(); in the Variables pane give Re a guess of
// 50000 and f a guess of 0.02, so it starts on the turbulent branch (the laminar branch has no slope in Re).
// h = 8000 [W/(m^2 K)]

// Simpson's rule with a for loop: integral of cp dT for N2 from 300 K to 1500 K (n must be even)
function q [J/mol] = simpson_cp(T1 [K], T2 [K], n)
  dT = (T2 - T1)/n
  q = ig_cp('N2', T1) + ig_cp('N2', T2)
  for i = 1:n-1
    if mod(i, 2) == 1
      q = q + 4*ig_cp('N2', T1 + i*dT)
    else
      q = q + 2*ig_cp('N2', T1 + i*dT)
    end
  end
  q = q*dT/3
end
dh_simpson = simpson_cp(300, 1500, 20)
dh_exact = ig_enthalpy('N2', 1500) - ig_enthalpy('N2', 300)
