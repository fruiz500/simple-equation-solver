--- /dev/null
+++ b/tests/browser/examples-page.test.cjs
@@ -0,0 +1,39 @@
+// Simple Equation Solver. Copyright (C) 2026 Francisco Ruiz.
+// SPDX-License-Identifier: GPL-3.0-or-later. Free software under the GNU General Public License v3 or later; no warranty. See LICENSE.
+// The Examples page of the landing site (tools/examples-page.mjs): it has every help example, and each link, opened in the app,
+// puts exactly that example in the editor. The examples whose guesses the link sets (which help-examples.test.cjs cannot solve by
+// pressing Solve) must then give their published results.
+const { open } = require('../lib/browser.cjs');
+(async () => {
+  let pass = 0, fail = 0; const ok = (n, c, x = '') => { if (c) pass++; else { fail++; console.log('FAIL', n, x === '' ? '' : '| ' + x); } };
+  const T = await import('../tools/examples-page.mjs'), H = await import('../lib/help.mjs');
+  const list = T.examples(), ids = Object.keys(H.CODE);
+  ok('the page has every help example, in order', list.map(e => e.id).join() === ids.join(), ids.filter(i => !list.some(e => e.id === i)).join());
+  ok('every example has a section, a title, a description and code', list.every(e => e.section && e.title && /<p>/.test(e.desc) && e.code.trim()), list.filter(e => !(e.section && e.title && e.desc && e.code)).map(e => e.id).join());
+  ok('an example without a result table keeps its note (ex-m5)', list.find(e => e.id === 'ex-m5')?.notes.includes('magnifier'));
+  const longest = Math.max(...list.map(e => (T.APP_URL + '#' + e.hash).length));
+  ok('every link is shorter than the length the app warns about (8000)', longest < 8000, longest);
+  const html = T.page(list);
+  ok('the page links each example to the app and to its place in the documentation', list.every(e => html.includes(`href="${T.APP_URL}#${e.hash}"`) && html.includes(`href="${T.DOCS_URL}#${e.id}"`)));
+  ok('the page says which guesses a link sets', /sets the guess <code>T = 500<\/code>/.test(html) && /sets the guesses <code>Q_2 = 0.01<\/code>/.test(html));
+
+  const app = await open(), { pg } = app;
+  const bad = [];
+  for (const e of list) {
+    await pg.evaluate(h => { location.hash = h; }, e.hash);
+    const got = await pg.waitForFunction(c => { const v = document.querySelector('#editor').value; return v === c + '\n' && v; }, e.code.replace(/\s+$/, ''), { timeout: 5000 })
+      .then(() => true).catch(() => false);
+    if (!got) { bad.push(e.id); continue; }
+    if (!T.GUESS[e.id]) continue;
+    await app.clear(); await pg.click('#btn-solve');
+    await pg.waitForFunction(() => /Solution Converged|ERROR|Error/.test(document.querySelector('#console-output').textContent), null, { timeout: 60000 }).catch(() => {});
+    const c = await app.sol(), rows = H.published(e.id);
+    const wrong = rows.filter(([n, v]) => { const m = c.match(new RegExp(`\\n  ${n.replace(/[[\]]/g, '\\$&')} = ([^ \\n]+)`)); return !m || m[1] !== v; });
+    ok(`${e.id}: the link sets ${Object.keys(T.GUESS[e.id]).join(', ')}, and Solve gives the ${rows.length} published values`, !wrong.length && !/ERROR/.test(c), wrong.map(r => r.join(' ')).join('; ') + (/ERROR.*/.exec(c)?.[0] || ''));
+  }
+  ok(`each of the ${list.length} links opens its example in the editor`, !bad.length, bad.join(', '));
+  ok('only the CDN libraries were requested', app.missing.length === 0, app.missing.join(', '));
+  ok('no uncaught page errors', app.pageErrors.length === 0, app.pageErrors.join(' | '));
+  await app.b.close();
+  console.log(`${pass} passed, ${fail} failed`); process.exitCode = fail ? 1 : 0;
+})().catch(e => { console.log('FAIL browser run |', e.message.split('\n')[0]); console.log('0 passed, 1 failed'); process.exitCode = 1; });
