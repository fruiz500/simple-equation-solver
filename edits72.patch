diff --git a/tests/tools/examples-page.mjs b/tests/tools/examples-page.mjs
new file mode 100644
index 0000000..d12d152
--- /dev/null
+++ b/tests/tools/examples-page.mjs
@@ -0,0 +1,138 @@
+// Simple Equation Solver. Copyright (C) 2026 Francisco Ruiz.
+// SPDX-License-Identifier: GPL-3.0-or-later. Free software under the GNU General Public License v3 or later; no warranty. See LICENSE.
+// Builds examples.html for the landing site from the examples of help.html: each one with its description, its equations and
+// published results, and a link that opens it in the app, in the format of the Share button (#s1= deflate-raw base64url JSON).
+// Usage (from the tests folder):  node tools/examples-page.mjs [output file, default ./examples.html]
+// Run it again whenever the help examples change, and upload the page next to the landing page (index.html).
+import fs from 'fs';
+import path from 'path';
+import zlib from 'zlib';
+import { fileURLToPath } from 'url';
+import { APP } from '../lib/engine.mjs';
+
+export const APP_URL = 'https://simplesolver.org/app/';
+export const DOCS_URL = APP_URL + 'help.html';
+// Examples whose text asks for a hand-set guess: the link sets it (Variables pane units), as in engine/help-special.test.mjs.
+export const GUESS = { 'ex-t5': { T: 500 }, 'ex-c2': { T_ad: 2000 }, 'ex-c6': { Q_2: 0.01, x_2: 0.61, T_2: 320 } };
+
+const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+const decode = (t) => t.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#x27;/g, "'").replace(/&#39;/g, "'").replace(/&amp;/g, '&');
+
+// The hash part of a share link, as the app's packShare makes it: JSON { e, v: { name: [guess, min, max, unit] } }.
+export function shareHash(code, guesses = {}) {
+  const v = Object.fromEntries(Object.entries(guesses).map(([n, g]) => [n, [g, null, null, '']]));
+  const json = Buffer.from(JSON.stringify({ e: code.replace(/\s+$/, ''), v }));
+  return 's1=' + zlib.deflateRawSync(json, { level: 9 }).toString('base64url');
+}
+
+// The examples of help.html in order: { id, section, title, desc (HTML), code, results (HTML of the table, or ''),
+// notes (HTML of the <p class="note"> after the code, or ''), hash }. Each example is cut at the start of the next one
+// (or of the next section heading), so one without a result table cannot take the next one's.
+export function examples(html = fs.readFileSync(path.join(APP, 'help.html'), 'utf8')) {
+  const marks = [...html.matchAll(/<h3 id="ex-[\w-]+">(.*?)<\/h3>|<div class="example item" id="([\w-]+)"[^>]*>/g)];
+  const out = []; let section = '';
+  marks.forEach((m, i) => {
+    if (m[1] !== undefined) { section = m[1]; return; }
+    const id = m[2], block = html.slice(m.index, i + 1 < marks.length ? marks[i + 1].index : undefined);
+    const b = /<h4>(.*?)<\/h4>(.*?)<div class="codewrap"><pre><code>(.*?)<\/code><\/pre>/s.exec(block);
+    if (!b) throw new Error(`help.html: example ${id} has no title or code`);
+    const code = decode(b[3]);
+    out.push({ id, section, title: b[1], desc: b[2].trim(), code, results: (/<table class="res">.*?<\/table>/s.exec(block) || [''])[0],
+      notes: [...block.matchAll(/<p class="note">.*?<\/p>/gs)].map(n => n[0]).join(''), hash: shareHash(code, GUESS[id]) });
+  });
+  return out;
+}
+
+const slug = (s) => 's-' + s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+
+export function page(list = examples()) {
+  const sections = [...new Set(list.map(e => e.section))];
+  const card = (e) => {
+    const g = GUESS[e.id] ? `<p class="hint">The link also sets the guess${Object.keys(GUESS[e.id]).length > 1 ? 'es' : ''} ` +
+      Object.entries(GUESS[e.id]).map(([n, v]) => `<code>${n} = ${v}</code>`).join(', ') + ' in the Variables pane.</p>' : '';
+    return `<article class="card" id="${e.id}">
+  <h3>${e.title}</h3>
+  <div class="desc">${e.desc}</div>${g}
+  <details><summary>Equations and results</summary><pre><code>${esc(e.code)}</code></pre>${e.results}${e.notes}</details>
+  <div class="links"><a class="btn-primary" href="${APP_URL}#${e.hash}" target="_blank" rel="noopener">Open in SimpleSolver</a><a href="${DOCS_URL}#${e.id}">In the documentation</a></div>
+</article>`;
+  };
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <link rel="icon" type="image/svg+xml" href="favicon.svg">
+  <title>Examples — SimpleSolver</title>
+  <meta name="description" content="Worked examples for SimpleSolver, the free browser equation solver: mathematics, thermodynamics, heat transfer, functions, differential equations and arrays. Each opens in the app, ready to solve.">
+  <style>
+    :root { --bg: #0f172a; --card: #1e293b; --text: #f8fafc; --muted: #94a3b8; --accent: #38bdf8; --accent-hover: #0284c7; --border: #334155; }
+    * { box-sizing: border-box; }
+    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
+    a { color: var(--accent); }
+    header { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
+    .logo { font-size: 1.25rem; font-weight: 700; color: var(--accent); text-decoration: none; }
+    nav { display: flex; align-items: center; }
+    nav a { color: var(--muted); text-decoration: none; margin-left: 1.5rem; font-size: 0.95rem; }
+    nav a:hover { color: var(--text); }
+    nav a.btn-primary { color: #0f172a; padding: 0.4rem 1rem; }
+    .btn-primary { background: var(--accent); color: #0f172a; padding: 0.5rem 1.1rem; border-radius: 8px; font-weight: 600; text-decoration: none; transition: background 0.2s; }
+    .btn-primary:hover { background: var(--accent-hover); color: #fff; }
+    main { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
+    h1 { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.025em; margin: 1rem 0 0.5rem; }
+    p.lead { color: var(--muted); font-size: 1.1rem; max-width: 800px; margin: 0; }
+    .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0 0; }
+    .toc a { font-size: 0.85rem; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0.15rem 0.75rem; text-decoration: none; }
+    .toc a:hover { color: var(--text); }
+    h2 { font-size: 1.6rem; letter-spacing: -0.015em; margin: 3.5rem 0 0; scroll-margin-top: 1rem; }
+    .grid { margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; }
+    .card { background: var(--card); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px; min-width: 0; scroll-margin-top: 1rem; }
+    .card h3 { margin: 0 0 0.5rem; color: var(--accent); font-size: 1.1rem; }
+    .desc p, .hint, p.note { color: var(--muted); font-size: 0.95rem; margin: 0 0 0.5rem; }
+    .hint { font-style: italic; }
+    p.note { margin-top: 0.75rem; }
+    code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.88em; color: #e2e8f0; }
+    details { margin: 0.75rem 0 0; }
+    summary { cursor: pointer; color: var(--muted); font-size: 0.9rem; }
+    pre { margin: 0.75rem 0 0; padding: 1rem; background: #020617; border: 1px solid var(--border); border-radius: 8px; overflow-x: auto; font-size: 0.85rem; }
+    table.res { margin: 0.75rem 0 0; border-collapse: collapse; font-size: 0.85rem; }
+    table.res td { padding: 0.15rem 0.75rem 0.15rem 0; color: var(--muted); }
+    table.res td.num { color: var(--text); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; text-align: right; }
+    .links { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin: 1rem 0 0; font-size: 0.9rem; }
+    .links a:not(.btn-primary) { color: var(--muted); }
+    footer { border-top: 1px solid var(--border); margin-top: 5rem; padding: 2rem 1.5rem; text-align: center; color: var(--muted); font-size: 0.9rem; }
+    @media (max-width: 560px) { h1 { font-size: 1.8rem; } nav a:not(.btn-primary) { display: none; } .grid { grid-template-columns: 1fr; } }
+  </style>
+</head>
+<body>
+  <header>
+    <a href="./" class="logo">SimpleSolver</a>
+    <nav>
+      <a href="${DOCS_URL}">Documentation</a>
+      <a href="https://github.com/fruiz500/simple-equation-solver">GitHub</a>
+      <a href="${APP_URL}" class="btn-primary">Launch App</a>
+    </nav>
+  </header>
+  <main>
+    <h1>Examples</h1>
+    <p class="lead">${list.length} worked problems from the documentation. Each link opens SimpleSolver with the equations loaded: press Solve (F2) and change anything you like. Nothing is sent to a server; the equations travel inside the link.</p>
+    <div class="toc">${sections.map(s => `<a href="#${slug(s)}">${s}</a>`).join('')}</div>
+${sections.map(s => `    <h2 id="${slug(s)}">${s}</h2>
+    <div class="grid">
+${list.filter(e => e.section === s).map(card).join('\n')}
+    </div>`).join('\n')}
+  </main>
+  <footer>
+    <p>Free software, released under the GNU GPL v3 or later. &copy; 2026 <a href="./" style="color: var(--accent); text-decoration: none;">Francisco Ruiz</a>.</p>
+  </footer>
+</body>
+</html>
+`;
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const out = path.resolve(process.argv[2] || 'examples.html'), list = examples();
+  fs.writeFileSync(out, page(list));
+  const longest = Math.max(...list.map(e => (APP_URL + '#' + e.hash).length));
+  console.log(`Wrote ${out}: ${list.length} examples in ${new Set(list.map(e => e.section)).size} sections, longest link ${longest} characters.`);
+}
